+CARGO_BUILD_JOBS=8 timeout 900 cargo test -p aq-node-service --locked config::tests -- --test-threads=8
+CARGO_BUILD_JOBS=8 timeout 900 cargo test -p aq-node-service --locked supervisor::tests::node_slots_grow -- --test-threads=8
