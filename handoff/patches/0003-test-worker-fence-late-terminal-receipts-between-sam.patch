From: Jack Kern <jack.w.kern@gmail.com>
Date: Tue, 17 Nov 2026 06:01:21 -0800
Subject: [PATCH 3/4] test(worker): fence late terminal receipts between
 same-boot agent slots

---
 crates/aq-worker/tests/native_http.rs | 43 +++++++++++++++++++++++++++
 handoff/multi-agent-worker.md         |  9 ++++++
 2 files changed, 52 insertions(+)

diff --git a/crates/aq-worker/tests/native_http.rs b/crates/aq-worker/tests/native_http.rs
index 66ccebe..4156bc1 100644
--- a/crates/aq-worker/tests/native_http.rs
+++ b/crates/aq-worker/tests/native_http.rs
@@ -754,3 +754,46 @@ async fn overloaded_registration_is_resent_and_a_refusal_is_final() {
         assert_eq!(calls.load(Ordering::SeqCst), sends, "{status}");
     }
 }
+
+#[test]
+fn late_stopped_receipt_is_refused_for_a_sibling_attempt_of_the_same_boot() {
+    let a = stopped::decode_request(include_bytes!(
+        "../../../vendor/aq-admission-0.1.6/artifacts/stopped.fixture.json"
+    ))
+    .unwrap();
+    let receipt = stopped::Receipt {
+        schema_version: 1,
+        operation_id: a.evidence.stop_operation_id,
+        binding: a.evidence.binding.clone(),
+        grant_id: a.grant_id().unwrap(),
+        request_digest: a.digest().unwrap(),
+        recorded_at_ms: 1500,
+        authority_revision_at_record: 4,
+    };
+    let mut b = a.clone();
+    let id = Uuid::new_v4();
+    b.evidence.binding.attempt_id = id;
+    if let aq_session_protocol::SessionIdentity::Remote { attempt_id, .. } =
+        &mut b.evidence.binding.session
+    {
+        *attempt_id = id;
+    }
+    b.proof.observation.guardian.intent.session = b.evidence.binding.session.clone();
+    b.evidence.stop_operation_id = Uuid::new_v4();
+    let digest = b.proof.digest().unwrap();
+    if let aq_admission::transport::StopDisposition::Stopped {
+        stop_receipt_digest,
+        ..
+    } = &mut b.evidence.disposition
+    {
+        *stop_receipt_digest = digest;
+    }
+    b.validate().unwrap();
+    let bytes = serde_json::to_vec(&receipt).unwrap();
+    assert!(stopped::decode_receipt(&bytes, &a).is_ok());
+    assert!(stopped::decode_receipt(&bytes, &b).is_err());
+    // Even a misleading operation id cannot turn A's terminal receipt into B's.
+    let mut replay = receipt;
+    replay.operation_id = b.evidence.stop_operation_id;
+    assert!(replay.validate_for(&b).is_err());
+}
diff --git a/handoff/multi-agent-worker.md b/handoff/multi-agent-worker.md
index 0ccedc9..7fd7ea8 100644
--- a/handoff/multi-agent-worker.md
+++ b/handoff/multi-agent-worker.md
@@ -60,3 +60,12 @@ Packaging tests: 34 passed, 30 failed, 1 skipped; all remaining failures occur a
 Unix-socket fixture, EPERM. Shell syntax and Python compilation checks passed. No live service,
 container, configuration or stack endpoint was touched. See open-contract-questions.md here
 for the worker's exact contract choices and required server behavior.
+
+## Progress 2026-11-17 — terminal correlation regression
+
+Added an existing-binary regression using two valid stopped requests of the same node boot:
+A's receipt is accepted for A and rejected for B, including after an operation-id substitution.
+Command: CARGO_BUILD_JOBS=8 timeout 900 cargo test -p aq-worker --locked --all-features
+--test native_http late_stopped_receipt -- --test-threads=8. Result: 1 passed.
+The six-agent journal test also passes, and all 7 native-runner tests now pass. The explicit
+supported service test run passes 14. The full workspace run is still pending at this point.
