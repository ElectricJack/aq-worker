# I4a (re-scoped): Claude Code CLI layered on the C3c rust template.
# Built locally and left unadmitted: the C3c template tool's scanner refuses
# on this host (GnuTLS), so this image never enters a template allowlist.
# No credential is baked in; the runner receives one only as private material.
ARG BASE=127.0.0.1:5138/electricjack/aq-template-unadmitted@sha256:4c9c20007445c3a207f31787e635ec753e64b13f22300cd90030784f7862a1c5
FROM ${BASE}
ARG CLAUDE_CODE_VERSION=2.1.318
# The template's private node runs npm only at build time; the installed CLI
# is the package's native executable and needs no node at run time.
RUN PATH=/opt/aq/node/bin:$PATH npm install --global --no-fund --no-audit \
        --prefix /opt/aq/harnesses/claude-code \
        "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && ln -s ../harnesses/claude-code/bin/claude /opt/aq/bin/claude \
    && rm -rf /root/.npm \
    && test "$(/opt/aq/bin/claude --version)" = "${CLAUDE_CODE_VERSION} (Claude Code)"
# Pinned CLI: no self-update, no non-essential traffic from the sandbox.
ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
