{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "end": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "end",
        "bytes",
        "digest"
      ],
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "id": {
          "$ref": "#/$defs/Text"
        },
        "version": {
          "$ref": "#/$defs/Text"
        }
      },
      "required": [
        "id",
        "version",
        "digest"
      ],
      "type": "object"
    },
    "ArtifactRole": {
      "enum": [
        "source",
        "checkpoint",
        "transcript",
        "result"
      ],
      "type": "string"
    },
    "Binding": {
      "additionalProperties": false,
      "properties": {
        "attempt_generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "attempt_id": {
          "format": "uuid",
          "type": "string"
        },
        "lineage_id": {
          "format": "uuid",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "type": "string"
        },
        "session": {
          "$ref": "#/$defs/SessionIdentity"
        },
        "task_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "task_id",
        "lineage_id",
        "attempt_id",
        "attempt_generation",
        "session"
      ],
      "type": "object"
    },
    "Cursor": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Anchor"
            },
            {
              "type": "null"
            }
          ]
        },
        "offset": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "offset"
      ],
      "type": "object"
    },
    "Digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "EventRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "event_id": {
          "format": "uuid",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "digest"
      ],
      "type": "object"
    },
    "ReplayFact": {
      "additionalProperties": false,
      "properties": {
        "prior": {
          "$ref": "#/$defs/EventRef"
        },
        "selected_record_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "prior",
        "selected_record_digest"
      ],
      "type": "object"
    },
    "RetentionReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "binding_digest": {
          "$ref": "#/$defs/Digest"
        },
        "bytes": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "owner": {
          "$ref": "#/$defs/Text"
        },
        "receipt_id": {
          "format": "uuid",
          "type": "string"
        },
        "retained_at_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "retained_until_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/$defs/ArtifactRole"
        }
      },
      "required": [
        "receipt_id",
        "owner",
        "binding_digest",
        "artifact",
        "role",
        "bytes",
        "retained_at_ms",
        "retained_until_ms"
      ],
      "type": "object"
    },
    "SessionIdentity": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "assignment_generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "attempt_id": {
              "format": "uuid",
              "type": "string"
            },
            "boot_id": {
              "format": "uuid",
              "type": "string"
            },
            "kind": {
              "const": "remote",
              "type": "string"
            },
            "node_id": {
              "format": "uuid",
              "type": "string"
            },
            "session_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "node_id",
            "boot_id",
            "attempt_id",
            "assignment_generation",
            "session_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authority_id": {
              "format": "uuid",
              "type": "string"
            },
            "generation": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "central",
              "type": "string"
            },
            "session_id": {
              "format": "uuid",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "authority_id",
            "session_id",
            "generation"
          ],
          "type": "object"
        }
      ]
    },
    "Text": {
      "description": "Nonempty UTF-8 text, at most 512 bytes; no control characters.",
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/Binding"
    },
    "known": {
      "additionalProperties": {
        "$ref": "#/$defs/ReplayFact"
      },
      "maxProperties": 128,
      "minProperties": 1,
      "type": "object"
    },
    "native_session_key": {
      "$ref": "#/$defs/Text"
    },
    "new_parser": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "old_parser": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "operation_id": {
      "format": "uuid",
      "type": "string"
    },
    "retained_cursor": {
      "$ref": "#/$defs/Cursor"
    },
    "source_generation": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "source_id": {
      "format": "uuid",
      "type": "string"
    },
    "transcript": {
      "$ref": "#/$defs/RetentionReceipt"
    }
  },
  "required": [
    "operation_id",
    "source_id",
    "source_generation",
    "native_session_key",
    "binding",
    "old_parser",
    "new_parser",
    "retained_cursor",
    "transcript",
    "known"
  ],
  "title": "ReparsePlan",
  "type": "object",
  "x-host-authority-required": true,
  "x-max-retained-raw-bytes": 4194304
}
